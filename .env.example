# Base de datos libSQL / Turso
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# API de tasas (Dolary — default si no se define)
RATES_API_URL=https://dolary.zoysoftware.com/api/rates

# OpenRouter + AI SDK (modelo configurable)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1-distill-qwen-32b

# Clima para LoveOps (OpenWeatherMap — opcional)
OPENWEATHER_API_KEY=
WEATHER_LAT=10.1621
WEATHER_LON=-68.0077
WEATHER_LOCATION_LABEL=Carabobo

# LoveOps — nombre de pareja en recordatorios (opcional)
LOVE_PARTNER_NAME=Natalia
